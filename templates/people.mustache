{{!
    @template local_appraisal/people

    The appraiser's worklist of people they appraise.

    Context variables required for this template:
    * findform - rendered Find a user form HTML, or null
    * filters - array of value, label, url, active
    * initialsbar - rendered initials bars HTML
    * haspeople, people - rows of fullname, picture, url, assignments, open, awaiting, overdue, nextdue. picture is
      the user's picture (or initials) rendered by core's user_picture, hidden from screen readers by the template

    Example context (json):
    {
        "findform": "<form></form>",
        "filters": [
            {"value": "all", "label": "All", "url": "#", "active": true},
            {"value": "attention", "label": "Needs attention", "url": "#", "active": false}
        ],
        "initialsbar": "",
        "haspeople": true,
        "people": [
            {"fullname": "Jo Bloggs", "picture": "<span class=\"userinitials size-35\">JB</span>",
             "url": "#", "assignments": 2, "open": 1, "awaiting": 1, "overdue": 1, "nextdue": "12 March 2027"}
        ]
    }
}}
{{#findform}}
<div class="mb-4">{{{findform}}}</div>
{{/findform}}
<div class="d-flex flex-wrap align-items-center mb-2">
    <div class="btn-group btn-group-sm me-3 mb-2" role="group" aria-label="{{#str}} appraisalfilter, local_appraisal {{/str}}">
        {{#filters}}
        <a href="{{url}}" class="btn {{#active}}btn-primary{{/active}}{{^active}}btn-outline-secondary{{/active}}"
           {{#active}}aria-current="true"{{/active}}>{{label}}</a>
        {{/filters}}
    </div>
</div>
<div class="local-appraisal-initials">{{{initialsbar}}}</div>
{{#haspeople}}
<div class="table-responsive">
<table class="table generaltable mt-3">
    <thead>
        <tr>
            <th scope="col">{{#str}} name {{/str}}</th>
            <th scope="col">{{#str}} appraisals, local_appraisal {{/str}}</th>
            <th scope="col">{{#str}} open, local_appraisal {{/str}}</th>
            <th scope="col">{{#str}} awaitingsignoff, local_appraisal {{/str}}</th>
            <th scope="col">{{#str}} overdue, local_appraisal {{/str}}</th>
            <th scope="col">{{#str}} nextdue, local_appraisal {{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#people}}
        <tr>
            <td>
                <a href="{{url}}" class="d-inline-flex align-items-center">
                    <span class="me-2" aria-hidden="true">{{{picture}}}</span>{{fullname}}
                </a>
            </td>
            <td>{{assignments}}</td>
            <td>{{open}}</td>
            <td>
                {{#awaiting}}<span class="badge bg-warning text-dark">{{awaiting}}</span>{{/awaiting}}
                {{^awaiting}}0{{/awaiting}}
            </td>
            <td>{{#overdue}}<span class="badge bg-danger">{{overdue}}</span>{{/overdue}}{{^overdue}}0{{/overdue}}</td>
            <td>{{nextdue}}{{^nextdue}}&mdash;{{/nextdue}}</td>
        </tr>
        {{/people}}
    </tbody>
</table>
</div>
{{/haspeople}}
{{^haspeople}}
<p class="mt-3">{{#str}} nopeople, local_appraisal {{/str}}</p>
{{/haspeople}}
