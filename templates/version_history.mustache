{{!
    @template local_appraisal/version_history

    A template's version history list.

    Context variables required for this template:
    * history - array of number, statusname, fields, records, url, current

    Example context (json):
    {
        "history": [
            {"number": 2, "statusname": "Draft", "fields": 3, "records": 0, "url": "#", "current": true},
            {"number": 1, "statusname": "Published", "fields": 3, "records": 4, "url": "#", "current": false}
        ]
    }
}}
<h3 class="mt-4">{{#str}} versionhistory, local_appraisal {{/str}}</h3>
<table class="table table-sm generaltable">
    <thead>
        <tr>
            <th scope="col">{{#str}} version {{/str}}</th>
            <th scope="col">{{#str}} status {{/str}}</th>
            <th scope="col">{{#str}} fields, local_appraisal {{/str}}</th>
            <th scope="col">{{#str}} records, local_appraisal {{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#history}}
        <tr{{#current}} class="table-active"{{/current}}>
            <td>{{#current}}{{number}}{{/current}}{{^current}}<a href="{{url}}">{{number}}</a>{{/current}}</td>
            <td>{{statusname}}</td>
            <td>{{fields}}</td>
            <td>{{records}}</td>
        </tr>
        {{/history}}
    </tbody>
</table>
