{{!
    @template local_appraisal/scale_list

    The Grading scales table.

    Context variables required for this template:
    * newurl - URL of the New scale form
    * hasscales - whether there are any rows
    * scales - array of rows, each with name (formatted), url, levels, archived (shown as a badge), usedby (number of
      templates) and actionmenu: the row's actions as core's kebab action menu, rendered by output\row_actions

    Example context (json):
    {
        "newurl": "#",
        "hasscales": true,
        "scales": [
            {
                "name": "Performance rating",
                "url": "#",
                "levels": 5,
                "archived": true,
                "usedby": 2,
                "actionmenu": "<div class=\"action-menu\"><a href=\"#\" role=\"button\">Actions</a></div>"
            }
        ]
    }
}}
<div class="mb-3">
    <a href="{{newurl}}" class="btn btn-primary">{{#str}} newscale, local_appraisal {{/str}}</a>
</div>
{{#hasscales}}
<div class="table-responsive">
<table class="table table-striped generaltable">
    <thead>
        <tr>
            <th scope="col">{{#str}} scalename, local_appraisal {{/str}}</th>
            <th scope="col">{{#str}} levels, local_appraisal {{/str}}</th>
            <th scope="col">{{#str}} usedby, local_appraisal {{/str}}</th>
            <th scope="col"><span class="visually-hidden">{{#str}} actions {{/str}}</span></th>
        </tr>
    </thead>
    <tbody>
        {{#scales}}
        <tr>
            <td>
                <a href="{{url}}">{{{name}}}</a>
                {{#archived}}
                <span class="badge bg-warning text-dark ms-1">{{#str}} statusarchived, local_appraisal {{/str}}</span>
                {{/archived}}
            </td>
            <td>{{levels}}</td>
            <td>{{usedby}}</td>
            <td>{{{actionmenu}}}</td>
        </tr>
        {{/scales}}
    </tbody>
</table>
</div>
{{/hasscales}}
{{^hasscales}}
<p>{{#str}} noscales, local_appraisal {{/str}}</p>
{{/hasscales}}
